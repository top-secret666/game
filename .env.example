# ─────────────────────────────────────────────────────────────────
# .env.example  –  copy to .env and fill in real values.
# Copy: cp .env.example .env
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────
# Used by both the 'db' service and spring-boot app in compose.
DB_NAME=game
DB_USERNAME=game_user
DB_PASSWORD=change_me_in_production

# DB_URL is only needed when running the app OUTSIDE of compose
# (compose injects jdbc:postgresql://db:5432/${DB_NAME} automatically).
# DB_URL=jdbc:postgresql://localhost:5432/game

# ── Application ───────────────────────────────────────────────
APP_PORT=8080

# ── Logging  (DEBUG | INFO | WARN | ERROR) ────────────────────
LOG_LEVEL=INFO
